#!/usr/bin/env node
import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { callKey } from './sipfax-call-key.mjs';
import { spawnSync } from 'node:child_process';

const action = process.argv[2];
const callId = process.argv[3];
const interfaceName = process.argv[4] ?? '';
const localAddress = process.argv[5] ?? '';
const remoteAddress = process.argv[6] ?? '';

const leaseDir = process.env.SIPFAX_PPP_LEASE_DIR ?? '/run/sipfax/ppp-leases';
const activeDir = process.env.SIPFAX_PPP_ACTIVE_DIR ?? '/run/sipfax/ppp-egress-active';
const sysctlCommand = process.env.SIPFAX_SYSCTL_COMMAND ?? 'sysctl';

if (!['up', 'down'].includes(action) || !callId) {
  console.error('usage: sipfax-egress-apply up|down <call-id> [interface] [local-ip] [remote-ip]');
  process.exit(64);
}

// Kernel locks are released on exit, including crashes. Serialize the entire
// rule/marker/forwarding transaction across independently spawned PPP hooks.
mkdirSync(activeDir, { recursive: true, mode: 0o750 });
const lockPath = join(activeDir, '.hook.lock');
if (process.env.SIPFAX_EGRESS_HELD_LOCK !== lockPath) {
  const locked = spawnSync('flock', ['-x', lockPath, process.execPath, process.argv[1], ...process.argv.slice(2)], {
    env: { ...process.env, SIPFAX_EGRESS_HELD_LOCK: lockPath },
    stdio: 'inherit'
  });
  if (locked.error) console.error(locked.error.message);
  process.exit(locked.status ?? 1);
}

const safeCallId = callKey(callId);
const descriptorPath = join(leaseDir, `${safeCallId}.json`);
if (!existsSync(descriptorPath)) {
  console.error(`sipfax egress descriptor not found: ${descriptorPath}`);
  process.exit(66);
}

const descriptor = JSON.parse(readFileSync(descriptorPath, 'utf8'));
if (descriptor.callId !== callId) {
  throw new Error('PPP descriptor Call-ID does not match the hook invocation');
}
mkdirSync(activeDir, { recursive: true, mode: 0o750 });

const forwardingPath = join(activeDir, '.forwarding-state');
const marker = activePath(safeCallId);
const activeLease = existsSync(marker) ? JSON.parse(readFileSync(marker, 'utf8')) : null;
const sameLease = activeLease && activeLease.callId === callId
  && activeLease.interfaceName === interfaceName
  && activeLease.localAddress === localAddress
  && activeLease.remoteAddress === remoteAddress;
if (action === 'up' && activeLease) {
  if (!sameLease || activeLease.rulesRemoved) throw new Error('Call-ID already has another active or unfinished PPP lease');
  process.exit(0); // Repeated notification for an already installed lease.
}
if (action === 'down' && !sameLease) {
  process.exit(0); // Duplicate teardown or an old interface after reconnect.
}

if (action === 'up') {
  // Install the lease policy before making packets eligible for forwarding.
  // A rejected atomic nft transaction must not enable an unfiltered path.
  applyRules(descriptor, 'up');
  try {
    retainForwarding();
    setForwarding(descriptor, true);
  } catch (error) {
    try {
      applyRules(descriptor, 'down');
      if (!hasActiveLeases()) restoreRetainedForwarding();
    }
    catch (cleanupError) { throw new AggregateError([error, cleanupError], 'Forwarding activation and policy cleanup failed'); }
    throw error;
  }
  writeFileSync(activePath(safeCallId), JSON.stringify({
    callId,
    interfaceName,
    localAddress,
    remoteAddress,
    outboundInterface: descriptor.outboundInterface,
    activatedAt: new Date().toISOString()
  }, null, 2));
  await postOperatorEvent(descriptor, 'ip-up');
} else {
  if (!activeLease.rulesRemoved) {
    applyRules(descriptor, 'down');
    saveState(marker, { ...activeLease, rulesRemoved: true });
  }
  if (!hasActiveLeases(safeCallId)) restoreRetainedForwarding();
  rmSync(marker, { force: true });
  await postOperatorEvent(descriptor, 'ip-down');
}

function applyRules(descriptor, ruleAction) {
  if (commandExists('nft') && descriptor.nft?.[ruleAction]?.length) {
    run('nft', ['-f', '-'], descriptor.nft[ruleAction].join('\n') + '\n');
    return;
  }

  const iptables = commandExists('iptables-nft') ? 'iptables-nft' : 'iptables';
  const operations = (descriptor.iptables?.[ruleAction] ?? []).map(rule => {
    const args = rule.split(/\s+/);
    const command = args.shift();
    const operation = args.indexOf(ruleAction === 'up' ? '-A' : '-D');
    if (command !== 'iptables' || operation < 0) {
      throw new Error('Unsupported iptables lease operation');
    }
    return { args, operation };
  });
  const installed = [];
  try {
    for (const entry of operations) {
      run(iptables, entry.args);
      installed.push(entry);
    }
  } catch (error) {
    if (ruleAction !== 'up') throw error;
    const errors = [error];
    // Only undo commands that succeeded in this invocation. Reversing the
    // entire descriptor would touch rules that were never installed.
    for (const entry of installed.reverse()) {
      const undo = [...entry.args];
      undo[entry.operation] = '-D';
      try { run(iptables, undo); }
      catch (cleanupError) { errors.push(cleanupError); }
    }
    throw new AggregateError(errors, 'iptables policy installation failed; attempted cleanup');
  }
}

function setForwarding(descriptor, enabled) {
  const value = enabled ? '1' : '0';
  const keys = ['net.ipv4.ip_forward'];
  if (descriptor.outboundInterface) {
    keys.push(`net.ipv4.conf.${descriptor.outboundInterface}.forwarding`);
  }
  // Read both values before changing either. Missing interfaces fail without
  // partially enabling forwarding; avoid rewriting a surviving caller's state.
  const previous = keys.map(key => {
    const original = run(sysctlCommand, ['-n', key]).trim();
    if (!['0', '1'].includes(original)) throw new Error(`Invalid forwarding value for ${key}`);
    return { key, original };
  });
  try {
    for (const entry of previous) {
      if (entry.original === value) continue;
      run(sysctlCommand, ['-w', `${entry.key}=${value}`]);
    }
  } catch (error) {
    const errors = [error];
    // Restore the global switch before explicit per-interface values because
    // changing ip_forward also changes interface forwarding defaults.
    for (const entry of previous) {
      try {
        if (run(sysctlCommand, ['-n', entry.key]).trim() !== entry.original) {
          run(sysctlCommand, ['-w', `${entry.key}=${entry.original}`]);
        }
      }
      catch (restoreError) { errors.push(restoreError); }
    }
    throw new AggregateError(errors, 'Forwarding update failed; attempted restoration');
  }
}

function run(command, args, input = null) {
  const result = spawnSync(command, args, {
    input,
    encoding: 'utf8',
    stdio: input === null ? ['ignore', 'pipe', 'pipe'] : ['pipe', 'pipe', 'pipe']
  });
  if (result.status !== 0) {
    const detail = (result.stderr || result.stdout || '').trim();
    throw new Error(`${command} ${args.join(' ')} failed${detail ? `: ${detail}` : ''}`);
  }
  return result.stdout ?? '';
}

function commandExists(command) {
  return spawnSync('/bin/sh', ['-c', 'command -v -- "$1" >/dev/null 2>&1', 'sipfax-command-exists', command], {
    stdio: 'ignore'
  }).status === 0;
}

function activePath(id) {
  return join(activeDir, `${id}.json`);
}

function hasActiveLeases(except = null) {
  return readdirSync(activeDir).some(name => name.endsWith('.json') && name !== `${except}.json`);
}

function saveState(path, value) {
  const temporary = `${path}.pending`;
  writeFileSync(temporary, JSON.stringify(value), { mode: 0o600 });
  renameSync(temporary, path);
}

function forwardingSnapshot(requireOutbound = true) {
  const values = { 'net.ipv4.ip_forward': run(sysctlCommand, ['-n', 'net.ipv4.ip_forward']).trim() };
  const listing = run(sysctlCommand, ['-a', '--pattern', '^net.ipv4.conf\\..*\\.forwarding$']);
  for (const line of listing.split('\n')) {
    const match = line.match(/^(net\.ipv4\.conf\..+\.forwarding)\s*=\s*([01])$/);
    if (match) values[match[1]] = match[2];
  }
  if (requireOutbound && descriptor.outboundInterface) {
    const key = `net.ipv4.conf.${descriptor.outboundInterface}.forwarding`;
    values[key] ??= run(sysctlCommand, ['-n', key]).trim();
  }
  for (const value of Object.values(values)) {
    if (!['0', '1'].includes(value)) throw new Error('Invalid forwarding snapshot');
  }
  return values;
}

function retainForwarding() {
  // A leftover snapshot with no active leases means a previous cleanup failed.
  // Restore it before recording another baseline; never overwrite that evidence.
  if (!hasActiveLeases() && existsSync(forwardingPath)) restoreRetainedForwarding();
  const current = forwardingSnapshot();
  const retained = existsSync(forwardingPath) ? JSON.parse(readFileSync(forwardingPath, 'utf8')) : current;
  for (const [key, value] of Object.entries(current)) retained[key] ??= value;
  saveState(forwardingPath, retained);
}

function restoreRetainedForwarding() {
  if (!existsSync(forwardingPath)) throw new Error('Missing original forwarding state; refusing to guess');
  const retained = JSON.parse(readFileSync(forwardingPath, 'utf8'));
  const current = forwardingSnapshot(false);
  // Global first: its restoration can reset interface values. Re-read each
  // interface after that write. Interfaces removed since capture need no write.
  for (const [key, value] of Object.entries(retained)) {
    if (!(key in current)) continue;
    if (!['0', '1'].includes(value)) throw new Error('Invalid retained forwarding value');
    if (run(sysctlCommand, ['-n', key]).trim() !== value) run(sysctlCommand, ['-w', `${key}=${value}`]);
  }
  rmSync(forwardingPath);
}

async function postOperatorEvent(descriptor, state) {
  if (!descriptor.operatorUrl) {
    return;
  }

  try {
    await fetch(new URL('/ppp/events', descriptor.operatorUrl), {
      signal: AbortSignal.timeout(2000),
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        state,
        callId,
        interfaceName,
        localAddress,
        remoteAddress,
        outboundInterface: descriptor.outboundInterface
      })
    });
  } catch {
    // Firewall changes must not depend on diagnostics delivery.
  }
}
